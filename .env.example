DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="https://your-staging-deployment.vercel.app"
FIRST_DIRECTOR_EMAIL="director@example.com"
FIRST_DIRECTOR_PASSWORD="set-a-strong-initial-password"
FIRST_DIRECTOR_NAME="Director"
MEASURER_CHATGPT_EMAIL="office@example.com"
MEASURER_CHATGPT_PASSWORD="set-the-shared-office-account-password"
# Scheduled founder-control job and authenticated BEKZAT OS bridge.
CRON_SECRET="replace-with-a-strong-random-secret"
FOUNDER_CONTROL_COMPANY_SLUG="your-company-slug"
BEKZAT_CONTROL_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Server-to-server token used only by the ALTYN SAPA WhatsApp contact center.
WHATSAPP_ORDER_STATUS_TOKEN="replace-with-a-strong-random-secret"
# Read-only Meta Marketing API connection. Use a long-lived system-user token with ads_read only.
META_AD_ACCOUNT_ID="replace-with-meta-ad-account-id"
META_ACCESS_TOKEN="replace-with-a-long-lived-system-user-token"
META_GRAPH_API_VERSION="v26.0"
# Optional fallback used only when the National Bank of Kazakhstan rate service is temporarily unavailable.
META_CURRENCY_TO_KZT_RATE=""
# Optional comma-separated campaign-name filters. Leave empty when the account is dedicated to ALTYN SAPA.
META_CAMPAIGN_NAME_FILTER=""
# Keep ordinary deployments read-only for staff tasks and payroll. Enable only for an explicit release-preparation run.
RUN_RELEASE_PREPARATION="false"
