  businessDate         DateTime         @db.Date
  responsibleManagerId Int
  responsibleManager   User             @relation("CashShiftResponsibleManager", fields: [responsibleManagerId], references: [id], onDelete: Restrict)
  openedAt             DateTime         @default(now())
  closedAt             DateTime?
  closedById           Int?
  closedBy             User?            @relation("CashShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  status               CashShiftStatus  @default(OPEN)
  payments             Payment[]
  receipts             PaymentReceipt[]

  @@index([responsibleManagerId, businessDate, status])
  @@index([businessDate, status])
  @@index([companyId, businessDate, status])
}

model PaymentReceipt {
  id                 Int                  @id @default(autoincrement())
  receiptNumber      Int                  @unique @default(autoincrement())
  paymentId          Int                  @unique
  payment            Payment              @relation("PaymentReceiptPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  documentId         Int                  @unique
  document           Document             @relation("PaymentReceiptDocument", fields: [documentId], references: [id], onDelete: Restrict)
  orderId            Int
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contractDocumentId Int?
  contractDocument   Document?            @relation("PaymentReceiptContract", fields: [contractDocumentId], references: [id], onDelete: Restrict)
  cashShiftId        Int
  cashShift          CashShift            @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  verificationToken  String               @unique
  status             PaymentReceiptStatus @default(ACTIVE)
  snapshot           Json
  snapshotChecksum   String
  voidedAt           DateTime?
  voidReason         String?
  voidedByPaymentId  Int?                 @unique
  voidedByPayment    Payment?             @relation("PaymentReceiptVoidingPayment", fields: [voidedByPaymentId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([orderId, createdAt])
  @@index([cashShiftId, createdAt])
  @@index([status, createdAt])
}

model CommercialAdjustment {
  id             Int      @id @default(autoincrement())
  companyId      Int      @default(dbgenerated())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  previousAmount Decimal  @db.Decimal(14, 2)
  newAmount      Decimal  @db.Decimal(14, 2)
  balanceImpact  Decimal  @db.Decimal(14, 2)
  reason         String
  authorId       Int
  author         User     @relation("CommercialAdjustmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  idempotencyKey String?  @unique
  requestHash    String?
  createdAt      DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([companyId, createdAt])
}

model PartnerAssignmentHistory {
  id                Int      @id @default(autoincrement())
  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  previousPartnerId Int?
  newPartnerId      Int
  previousPayable   Decimal  @db.Decimal(14, 2)
  newPayable        Decimal  @db.Decimal(14, 2)
  paidAtChange      Decimal  @db.Decimal(14, 2)
  remainingAtChange Decimal  @db.Decimal(14, 2)
  reason            String
  authorId          Int
  author            User     @relation("PartnerAssignmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([previousPartnerId, createdAt])
  @@index([newPartnerId, createdAt])
}

model PartnerOrderRelation {
  id               Int                          @id @default(autoincrement())
  companyId        Int                          @default(dbgenerated())
  company          Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partnerId        Int
  partner          Partner                      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  orderId          Int                          @unique
  order            Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rewardRule       PartnerRewardRule
  rewardPercent    Decimal?                     @db.Decimal(7, 4)
  fixedAmount      Decimal?                     @db.Decimal(14, 2)
  manualAmount     Decimal?                     @db.Decimal(14, 2)
  profitBasis      Decimal                      @db.Decimal(14, 2)
  startsAt         DateTime                     @default(now())
  settlementStatus PartnerSettlementStatus      @default(NOT_CALCULATED)
  comment          String?
  closedAt         DateTime?
  createdById      Int
  createdBy        User                         @relation("PartnerRelationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  operations       PartnerSettlementOperation[]
  auditEvents      PartnerAuditEvent[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([companyId, orderId])
  @@index([companyId, partnerId, settlementStatus])
  @@index([partnerId, createdAt])
}

model PartnerSettlementOperation {
  id               Int                              @id @default(autoincrement())
  companyId        Int                              @default(dbgenerated())
  company          Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  relationId       Int
  relation         PartnerOrderRelation             @relation(fields: [relationId], references: [id], onDelete: Restrict)
  partnerId        Int
  partner          Partner                          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  orderId          Int
  order            Order                            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type             PartnerSettlementOperationType
  status           PartnerSettlementOperationStatus @default(POSTED)
  amount           Decimal                          @db.Decimal(14, 2)
  adjustmentEffect Decimal                          @default(0) @db.Decimal(14, 2)
  operationDate    DateTime                         @default(now())
  method           String?
  account          String?
  comment          String?
  paymentId        Int?                             @unique
  payment          Payment?                         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversalOfId     Int?                             @unique
  reversalOf       PartnerSettlementOperation?      @relation("PartnerOperationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal         PartnerSettlementOperation?      @relation("PartnerOperationReversal")
  createdById      Int
  createdBy        User                             @relation("PartnerOperationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  idempotencyKey   String                           @unique
  requestHash      String
  createdAt        DateTime                         @default(now())
  auditEvents      PartnerAuditEvent[]

  @@index([companyId, operationDate, id])
  @@index([partnerId, operationDate])
  @@index([orderId, operationDate])
  @@index([relationId, operationDate])
}

model PartnerAuditEvent {
  id          Int                         @id @default(autoincrement())
  companyId   Int                         @default(dbgenerated())
  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partnerId   Int?
  partner     Partner?                    @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  relationId  Int?
  relation    PartnerOrderRelation?       @relation(fields: [relationId], references: [id], onDelete: Restrict)
  operationId Int?
  operation   PartnerSettlementOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  action      String
  before      Json?
  after       Json?
  comment     String?
  actorId     Int
  actor       User                        @relation("PartnerAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime                    @default(now())

  @@index([companyId, createdAt])
  @@index([partnerId, createdAt])
  @@index([relationId, createdAt])
  @@index([operationId, createdAt])
}

model FinanceAuditEvent {
  id         Int      @id @default(autoincrement())
  orderId    Int?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   Int?
  before     Json?
  after      Json?
  reason     String
  authorId   Int
  author     User     @relation("FinanceAuditAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Production {
  id Int @id @default(autoincrement())
  companyId Int @default(dbgenerated())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage   String
  percent Int    @default(0)

  master       String
  masterUserId Int?
  masterUser   User?  @relation(fields: [masterUserId], references: [id], onDelete: SetNull)

  startDate  DateTime?
  finishDate DateTime?

  comment        String?
  priority       Int                      @default(0)
  completedAt    DateTime?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualEndAt    DateTime?
  archivedAt     DateTime?
  archiveReason  String?
  stageHistory   ProductionStageHistory[]
  idempotencyKey String?                  @unique
  requestHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, stage])
  @@index([archivedAt, priority, createdAt, id])
  @@index([orderId])
  @@index([companyId, archivedAt, stage])
}

model ProductionStageHistory {
  id              Int        @id @default(autoincrement())
  productionId    Int
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  fromStage       String?
  toStage         String
  changedByUserId Int?
  comment         String?
  idempotencyKey  String?    @unique
  requestHash     String?
  createdAt       DateTime   @default(now())

  @@index([productionId, createdAt])
}

model Settings {
  id Int @id @default(autoincrement())
  companyId Int @default(dbgenerated())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  pinePrice Int @default(65000)
  elmPrice  Int @default(85000)
  oakPrice  Int @default(110000)

  woodRailing  Int @default(650000)
  glassRailing Int @default(900000)
  brassRailing Int @default(1800000)

  ledPrice          Int @default(250000)
  paintingPrice     Int @default(300000)
  installationPrice Int @default(350000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId])
}

model CalculatorTariff {
  id                  Int      @id @default(autoincrement())
  companyId           Int      @default(dbgenerated())
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code                String
  uiName              String
  kind                String
  unit                String
  salePrice           Decimal  @db.Decimal(12, 2)
  internalPrice       Decimal  @db.Decimal(12, 2)
  managerMinimumPrice Decimal  @default(0) @db.Decimal(12, 2)
  defaultQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  manualPriceAllowed  Boolean  @default(false)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([companyId, active, sortOrder])
  @@unique([companyId, code])
}

model OrderEvent {
  id Int @id @default(autoincrement())
  companyId Int @default(dbgenerated())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title       String
  description String?

  user           String?
  idempotencyKey String? @unique
  requestHash    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orderId, createdAt])
  @@index([companyId, createdAt])
}
