generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  MANAGER
  ACCOUNTANT
  MEASURER
  DESIGNER
  PARTNER
  PRODUCTION
  INSTALLER
}

enum DocumentType {
  OFFER
  CONTRACT
  ACT
  INVOICE
}

enum Permission {
  employees
  clients
  orders
  measurements
  calendar
  documents
  finance
  partners
  reports
  settings
  design
  production
  installation
  warehouse
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(MANAGER)
  phone     String?
  active    Boolean   @default(true)
  lastLogin DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime  @default(now())
  mustChangePassword  Boolean   @default(false)
  sessionVersion      Int       @default(1)

  partnerProfile        Partner?
  assignedMeasurements  Measurement[]
  assignedProductions   Production[]
  uploadedAttachments   Attachment[]          @relation("AttachmentUploadedBy")
  clientInteractions    ClientInteraction[]   @relation("ClientInteractionAuthor")
  clientAttachments     ClientAttachment[]    @relation("ClientAttachmentUploader")
  warehouseMovements    MaterialMovement[]    @relation("WarehouseMovementEmployee")
  warehouseReservations MaterialReservation[] @relation("WarehouseReservationCreator")
  warehouseMutations    WarehouseMutation[]   @relation("WarehouseMutationActor")
  companyLedgerEntries  CompanyLedgerEntry[]  @relation("CompanyLedgerAuthor")
  personalLedgerEntries PersonalLedgerEntry[] @relation("PersonalLedgerAuthor")
  authAuditEvents       AuthAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthAuditEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
}

model Client {
  id              Int     @id @default(autoincrement())
  name            String
  phone           String
  whatsapp        String  @default("")
  city            String
  address         String  @default("")
  manager         String
  amount          String
  status          String
  estimatedAmount Decimal @default(0) @db.Decimal(12, 2)
  estimateNotes   String  @default("")
  source          String  @default("")
  comment         String  @default("")
  active          Boolean @default(true)

  orders       Order[]
  interactions ClientInteraction[]
  attachments  ClientAttachment[]
  leadActivities LeadActivity[]
  leadStatusHistory LeadStatusHistory[]
  leadCalculations LeadCalculation[]
  commercialProposals CommercialProposal[]
  leadConversion LeadConversion?
  followUps LeadFollowUp[]
  priceApprovals PriceApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nextContactAt DateTime?

  @@index([status, nextContactAt])
  @@index([manager, status])
  @@index([source, createdAt])
}

model LeadActivity {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type String
  comment String
  authorId Int?
  authorName String
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
}

model LeadStatusHistory {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus String
  authorId Int?
  authorName String
  comment String?
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
}

model LeadCalculation {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  material String
  baseClientPrice Decimal @db.Decimal(12, 2)
  clientPrice Decimal @db.Decimal(12, 2)
  internalCost Decimal @db.Decimal(12, 2)
  snapshot Json
  comment String?
  authorId Int?
  authorName String
  createdAt DateTime @default(now())
  adjustments LeadPriceAdjustment[]
  proposals CommercialProposal[]
  priceApprovals PriceApprovalRequest[]
  @@index([clientId, createdAt])
}

model LeadPriceAdjustment {
  id Int @id @default(autoincrement())
  calculationId Int
  calculation LeadCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  originalPrice Decimal @db.Decimal(12, 2)
  newPrice Decimal @db.Decimal(12, 2)
  authorId Int?
  authorName String
  comment String?
  createdAt DateTime @default(now())
  @@index([calculationId, createdAt])
}

model CommercialProposal {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  calculationId Int
  calculation LeadCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  number String @unique
  status String @default("Черновик")
  snapshot Json
  validUntil DateTime
  executionTerm String
  paymentTerms String
  warranty String
  managerContact String
  sentAt DateTime?
  acceptedAt DateTime?
  createdById Int?
  createdByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversion LeadConversion?
  priceApprovals PriceApprovalRequest[]
  version Int @default(1)
  rootNumber String?
  @@index([clientId, createdAt])
  @@index([status, validUntil])
}

model LeadFollowUp {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId Int?
  proposalId Int?
  oldPrice Decimal @db.Decimal(12, 2)
  proposedPrice Decimal @db.Decimal(12, 2)
  standardPrice Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2)
  reason String
  comment String?
  channel String
  managerUserId Int
  managerName String
  nextActionAt DateTime
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([managerUserId, nextActionAt])
  @@index([clientId, createdAt])
}

model PriceApprovalRequest {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId Int
  calculation LeadCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  proposalId Int?
  proposal CommercialProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  managerUserId Int
  managerName String
  standardSalePrice Decimal @db.Decimal(12, 2)
  currentSalePrice Decimal @db.Decimal(12, 2)
  requestedSalePrice Decimal @db.Decimal(12, 2)
  approvedSalePrice Decimal? @db.Decimal(12, 2)
  snapshotHash String
  reason String
  comment String?
  status String @default("PENDING")
  reviewedAt DateTime?
  reviewedByUserId Int?
  reviewedByName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([managerUserId, createdAt])
  @@unique([calculationId, managerUserId, status])
}

model LeadConversion {
  id Int @id @default(autoincrement())
  clientId Int @unique
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposalId Int @unique
  proposal CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  orderId Int @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  managerId Int?
  managerName String
  createdAt DateTime @default(now())
}

model ClientInteraction {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation("ClientInteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  comment    String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientAttachment {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById Int?
  uploadedBy   User?    @relation("ClientAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  pathname     String   @unique
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
}

model Partner {
  id Int @id @default(autoincrement())

  name  String
  phone String?
  city  String?
  email String?

  active Boolean @default(true)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orders   Order[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     Int    @id @default(autoincrement())
  number String @unique

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  address   String
  staircase String
  material  String

  amount Decimal @db.Decimal(12, 2)

  prepayment Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @default(0) @db.Decimal(12, 2)

  partnerPrice   Decimal @default(0) @db.Decimal(12, 2)
  companyProfit  Decimal @default(0) @db.Decimal(12, 2)
  partnerPaid    Decimal @default(0) @db.Decimal(12, 2)
  partnerBalance Decimal @default(0) @db.Decimal(12, 2)

  manager String
  status  String @default("Новая заявка")

  measurements         Measurement[]
  payments             Payment[]
  productions          Production[]
  events               OrderEvent[]
  materialMovements    MaterialMovement[]
  documents            Document[]
  attachments          Attachment[]
  materialReservations MaterialReservation[]
  statusHistory        OrderStatusHistory[]
  calculations         OrderCalculation[]
  companyLedgerEntries CompanyLedgerEntry[]
  leadConversion LeadConversion?

  partnerPlannedReadyAt DateTime?
  partnerComment        String    @default("")
  readyForInstallation  Boolean   @default(false)
  installationCompleted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderStatusHistory {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  changedByUserId Int?
  changedByName   String
  changedByRole   Role
  comment         String?
  idempotencyKey  String?  @unique
  requestHash     String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderCalculation {
  id                   Int                    @id @default(autoincrement())
  orderId              Int
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material             String
  regularSteps         Int
  platformEquivalents  Int[]
  equivalentSteps      Int
  workshopRate         Decimal                @db.Decimal(12, 2)
  saleRate             Decimal                @db.Decimal(12, 2)
  baseWorkshopCost     Decimal                @db.Decimal(12, 2)
  workshopCost         Decimal                @db.Decimal(12, 2)
  baseClientPrice      Decimal                @db.Decimal(12, 2)
  clientPrice          Decimal                @db.Decimal(12, 2)
  grossDifference      Decimal                @db.Decimal(12, 2)
  workshopAdjustment   Decimal                @db.Decimal(12, 2)
  clientAdjustment     Decimal                @db.Decimal(12, 2)
  installationRequired Boolean                @default(true)
  deliveryRequired     Boolean                @default(true)
  otherCity            Boolean                @default(false)
  pickup               Boolean                @default(false)
  materialCost         Decimal                @default(0) @db.Decimal(12, 2)
  installationCost     Decimal                @default(0) @db.Decimal(12, 2)
  deliveryCost         Decimal                @default(0) @db.Decimal(12, 2)
  otherDirectCosts     Decimal                @default(0) @db.Decimal(12, 2)
  totalCost            Decimal                @default(0) @db.Decimal(12, 2)
  grossProfit          Decimal                @default(0) @db.Decimal(12, 2)
  lines                OrderCalculationLine[]
  createdByUserId      Int?
  createdByName        String
  idempotencyKey       String?                @unique
  requestHash          String?
  createdAt            DateTime               @default(now())

  @@index([orderId, createdAt])
}

model OrderCalculationLine {
  id            Int              @id @default(autoincrement())
  calculationId Int
  calculation   OrderCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  kind          String
  code          String?
  name          String
  quantity      Decimal          @db.Decimal(12, 3)
  unit          String
  unitCost      Decimal          @db.Decimal(12, 2)
  unitSale      Decimal          @db.Decimal(12, 2)
  totalCost     Decimal          @db.Decimal(12, 2)
  totalSale     Decimal          @db.Decimal(12, 2)
  comment       String?
  enabled       Boolean          @default(true)
  position      Int              @default(0)

  @@index([calculationId, position])
}

model CompanyLedgerEntry {
  id             Int      @id @default(autoincrement())
  type           String
  category       String
  direction      String
  amount         Decimal  @db.Decimal(14, 2)
  operationDate  DateTime @default(now())
  orderId        Int?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  comment        String?
  authorId       Int?
  author         User?    @relation("CompanyLedgerAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  idempotencyKey String?  @unique
  requestHash    String?
  createdAt      DateTime @default(now())

  @@index([operationDate])
  @@index([orderId])
}

model PersonalLedgerEntry {
  id             Int      @id @default(autoincrement())
  type           String
  category       String
  direction      String
  amount         Decimal  @db.Decimal(14, 2)
  operationDate  DateTime @default(now())
  comment        String?
  authorId       Int?
  author         User?    @relation("PersonalLedgerAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  idempotencyKey String?  @unique
  requestHash    String?
  createdAt      DateTime @default(now())

  @@index([operationDate])
}

model Document {
  id             Int          @id @default(autoincrement())
  orderId        Int
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           DocumentType
  number         String
  documentDate   DateTime
  idempotencyKey String?      @unique
  requestHash    String?
  attachments    Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, type])
  @@unique([type, number])
}

model Attachment {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentId     Int?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById   Int?
  uploadedBy     User?     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName       String
  pathname       String    @unique
  contentType    String
  size           Int
  idempotencyKey String?   @unique
  requestHash    String?
  createdAt      DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([documentId, createdAt])
}

model Material {
  id             Int     @id @default(autoincrement())
  name           String
  category       String
  unit           String
  minimumStock   Float   @default(0)
  stock          Float   @default(0)
  purchasePrice  Decimal @default(0) @db.Decimal(12, 2)
  supplier       String?
  active         Boolean @default(true)
  lookupKey      String  @unique
  reserved       Float   @default(0)
  idempotencyKey String? @unique
  requestHash    String?

  movements    MaterialMovement[]
  reservations MaterialReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id            Int    @id @default(1)
  name          String @default("ALTYN SAPA COMPANY")
  bin           String @default("")
  legalAddress  String @default("")
  actualAddress String @default("")
  phone         String @default("")
  whatsapp      String @default("")
  email         String @default("")
  bankDetails   String @default("")
  directorName  String @default("")
  logoUrl       String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id                   Int    @id @default(1)
  currency             String @default("KZT")
  timezone             String @default("Asia/Almaty")
  dateFormat           String @default("dd.MM.yyyy")
  minimumPrepayment    Int    @default(0)
  measurementLeadDays  Int    @default(3)
  productionLeadDays   Int    @default(40)
  installationLeadDays Int    @default(7)
  nextDocumentNumber   Int    @default(1)
  offerPrefix          String @default("КП")
  contractPrefix       String @default("ДОГ")
  actPrefix            String @default("АКТ")
  invoicePrefix        String @default("СЧ")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id         Int        @id @default(autoincrement())
  role       Role
  permission Permission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
}

model MaterialMovement {
  id Int @id @default(autoincrement())

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type           String
  quantity       Float
  price          Decimal  @default(0) @db.Decimal(12, 2)
  supplier       String?
  comment        String?
  idempotencyKey String?  @unique
  requestHash    String?
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  stockAfter     Float?
  reservedAfter  Float?
  stockDelta     Float    @default(0)
  reserveDelta   Float    @default(0)
  employeeId     Int?
  employee       User?    @relation("WarehouseMovementEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  operationAt    DateTime @default(now())

  createdAt DateTime @default(now())
}

model MaterialReservation {
  id          Int       @id @default(autoincrement())
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quantity    Float     @default(0)
  consumed    Float     @default(0)
  status      String    @default("ACTIVE")
  createdById Int?
  createdBy   User?     @relation("WarehouseReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderId, materialId])
  @@index([materialId, status])
  @@index([orderId, status])
}

model WarehouseMutation {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  requestHash String
  action      String
  result      Json
  actorId     Int?
  actor       User?    @relation("WarehouseMutationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Measurement {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  measurer       String
  measurerUserId Int?
  measurerUser   User?    @relation(fields: [measurerUserId], references: [id], onDelete: SetNull)
  visitDate      DateTime

  floorHeight    Float?
  staircaseWidth Float?
  stepsCount     Int?

  comment        String?
  idempotencyKey String? @unique
  requestHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  amount Float

  type   String
  method String

  comment        String?
  operationDate  DateTime @default(now())
  author         String?
  idempotencyKey String?  @unique
  requestHash    String?

  createdAt DateTime @default(now())
}

model Production {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage   String
  percent Int    @default(0)

  master       String
  masterUserId Int?
  masterUser   User?  @relation(fields: [masterUserId], references: [id], onDelete: SetNull)

  startDate  DateTime?
  finishDate DateTime?

  comment        String?
  priority       Int                      @default(0)
  completedAt    DateTime?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualEndAt    DateTime?
  stageHistory   ProductionStageHistory[]
  idempotencyKey String?                  @unique
  requestHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionStageHistory {
  id              Int        @id @default(autoincrement())
  productionId    Int
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  fromStage       String?
  toStage         String
  changedByUserId Int?
  comment         String?
  idempotencyKey  String?    @unique
  requestHash     String?
  createdAt       DateTime   @default(now())

  @@index([productionId, createdAt])
}

model Settings {
  id Int @id @default(1)

  pinePrice Int @default(65000)
  elmPrice  Int @default(85000)
  oakPrice  Int @default(110000)

  woodRailing  Int @default(650000)
  glassRailing Int @default(900000)
  brassRailing Int @default(1800000)

  ledPrice          Int @default(250000)
  paintingPrice     Int @default(300000)
  installationPrice Int @default(350000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalculatorTariff {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  uiName             String
  kind               String
  unit               String
  salePrice          Decimal  @db.Decimal(12, 2)
  internalPrice      Decimal  @db.Decimal(12, 2)
  managerMinimumPrice Decimal @default(0) @db.Decimal(12, 2)
  defaultQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  manualPriceAllowed Boolean  @default(false)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, sortOrder])
}

model OrderEvent {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title       String
  description String?

  user           String?
  idempotencyKey String? @unique
  requestHash    String?

  createdAt DateTime @default(now())
}
