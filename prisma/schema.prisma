generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  MANAGER
  ACCOUNTANT
  MEASURER
  DESIGNER
  PARTNER
  PRODUCTION
  INSTALLER
}

enum CompanyMode {
  LIVE
  DEMO
}

enum PartnerBusinessType {
  REFERRER
  SALES_AGENT
  DEALER
  DESIGNER
  ARCHITECT
  CONSTRUCTION_COMPANY
  CONTRACTOR
  OTHER
}

enum PartnerBusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PartnerRewardRule {
  FIXED
  ORDER_PERCENT
  PAID_PERCENT
  PROFIT_PERCENT
  MANUAL
}

enum PartnerSettlementStatus {
  NOT_CALCULATED
  CALCULATED
  PARTIALLY_PAID
  CLOSED
  PARTNER_OWES_COMPANY
  COMPANY_OWES_PARTNER
  DISPUTED
  CANCELLED
}

enum PartnerSettlementOperationType {
  CLIENT_TO_COMPANY
  CLIENT_TO_PARTNER
  PARTNER_TO_COMPANY
  COMPANY_TO_PARTNER
  CLIENT_REFUND
  PARTNER_REFUND
  ADJUSTMENT
  REVERSAL
}

enum PartnerSettlementOperationStatus {
  POSTED
  REVERSED
  DISPUTED
}

model Company {
  id       Int         @id @default(autoincrement())
  slug     String      @unique
  name     String
  currency String      @default("KZT")
  timezone String      @default("Asia/Almaty")
  mode     CompanyMode @default(LIVE)
  isDemo   Boolean     @default(false)
  active   Boolean     @default(true)

  users                    User[]
  clients                  Client[]
  commercialProposals      CommercialProposal[]
  partners                 Partner[]
  partnerOrderRelations    PartnerOrderRelation[]
  partnerOperations        PartnerSettlementOperation[]
  partnerAuditEvents       PartnerAuditEvent[]
  orders                   Order[]
  calendarTasks            CalendarTask[]
  companyLedgerEntries     CompanyLedgerEntry[]
  financeCategories        FinanceCategory[]
  employeePayrollProfiles  EmployeePayrollProfile[]
  payrollPeriods           PayrollPeriod[]
  personalLedgerEntries    PersonalLedgerEntry[]
  documents                Document[]
  attachments              Attachment[]
  materials                Material[]
  companySettings          CompanySettings[]
  systemSettings           SystemSettings[]
  materialMovements        MaterialMovement[]
  suppliers                Supplier[]
  purchaseBatches          PurchaseBatch[]
  inventoryValuations      InventoryValuationEntry[]
  inventoryCogsEntries     InventoryCogsEntry[]
  materialReservations     MaterialReservation[]
  warehouseMutations       WarehouseMutation[]
  measurements             Measurement[]
  payments                 Payment[]
  cashShifts               CashShift[]
  commercialAdjustments    CommercialAdjustment[]
  productions              Production[]
  settings                 Settings[]
  calculatorTariffs        CalculatorTariff[]
  orderEvents              OrderEvent[]
  rolePermissions          RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentType {
  OFFER
  CONTRACT
  CUSTOMER_MEMO
  PREPAYMENT_CONFIRMATION
  CLOSING_ACT
  WARRANTY
  FINAL_PAYMENT_CONFIRMATION
  ESTIMATE
  PROJECT
  MEASUREMENT_SHEET
  ACT
  INVOICE
  PAYMENT_RECEIPT
  PHOTO
  OTHER
}

enum PdfGenerationStatus {
  NOT_REQUESTED
  PENDING
  READY
  FAILED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum PaymentReceiptStatus {
  ACTIVE
  VOID
}

enum DocumentStatus {
  DRAFT
  READY
  SIGNED
  ARCHIVED
  CANCELLED
}

enum DocumentSource {
  UPLOADED
  GENERATED_ORDER
  GENERATED_PROPOSAL
  MEASUREMENT_ATTACHMENT
  ORDER_ATTACHMENT
}

enum Permission {
  employees
  clients
  orders
  measurements
  calendar
  documents
  finance
  partners
  reports
  settings
  design
  production
  installation
  warehouse
  payroll
}

enum LeadStage {
  NEW
  QUALIFIED
  CALCULATION_READY
  PROPOSAL_SENT
  FOLLOW_UP
  MEASUREMENT_SCHEDULED
  MEASUREMENT_COMPLETED
  NEGOTIATION
  WON
  LOST
}

enum LeadNextActionType {
  CALL
  WHATSAPP
  FOLLOW_UP
  MEASUREMENT
  MEETING
  CALCULATION
  PROPOSAL
  OTHER
}

enum PurchaseBatchStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  RECEIVED_PROVISIONAL
  COST_FINALIZED
  CLOSED
  CANCELLED
}

enum PurchaseAllocationMethod {
  BY_PURCHASE_VALUE
  BY_QUANTITY
  BY_WEIGHT
  MANUAL
}

enum PurchaseCostType {
  SUPPLIER_COMMISSION
  BANK_COMMISSION
  CARGO
  DELIVERY
  CUSTOMS
  INSURANCE
  PACKAGING
  CERTIFICATION
  OTHER
  SUPPLIER_CREDIT
}

enum InventoryCostStatus {
  LEGACY_UNVERIFIED
  PROVISIONAL
  FINAL
}

enum PayrollPeriodStatus {
  OPEN
  REVIEW
  CLOSED
}

enum PayrollAccrualType {
  BASE_SALARY
  GUARANTEED_ORDER_BONUS
  ORDER_BONUS
  MEASUREMENT_BONUS
  EXTRA_BONUS
  PREMIUM
  DEDUCTION
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  BONUS_REVERSAL
}

enum PayrollDirection {
  INCREASE
  DECREASE
}

enum PayrollPaymentType {
  ADVANCE
  IMMEDIATE_BONUS
  SALARY_PAYMENT
  GUARANTEED_BONUS_PAYMENT
  ORDER_BONUS_PAYMENT
  PREMIUM_PAYMENT
  FINAL_SETTLEMENT
  OTHER_PAYROLL_PAYMENT
  EMPLOYEE_REFUND
}

enum PayrollConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum AdvanceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum BonusPaymentMode {
  ACCUMULATE
  IMMEDIATE
}

enum PayrollBonusRule {
  FIXED
  PAID_PERCENT
  PROFIT_PERCENT
}

enum OrderLifecycle {
  CREATED
  PREPARATION
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  READY_FOR_INSTALLATION
  INSTALLATION
  ACCEPTANCE
  COMPLETED
  CANCELLED
}

enum OrderBlockerSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrderBlockerStatus {
  OPEN
  RESOLVED
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  CALL
  WEBSITE
  REFERRAL
  OFFICE
  REPEAT
  OTHER
}

enum LeadLostReason {
  EXPENSIVE
  PRICE_TOO_HIGH
  CHANGED_MIND
  COMPARING
  NOT_READY
  UNSUITABLE_SOLUTION
  NO_RESPONSE
  COMPETITOR
  POSTPONED
  NO_BUDGET
  NOT_RELEVANT
  LOCATION
  TIMING
  OTHER
}

enum CalendarTaskType {
  CALL
  MEETING
  MEASUREMENT
  INSTALLATION
  DELIVERY
  TASK
  REMINDER
  OTHER
}

enum CalendarTaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CalendarTaskPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum MeasurementStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  HANDED_TO_MANAGER
  CANCELLED
}

enum MeasurementClientOutcome {
  READY_TO_CONTINUE
  RETURN_TO_MANAGER
  REFUSED
}

enum MeasurementPhotoType {
  SHEET
  OPENING
  OBJECT
  EXTRA
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_TEST
  FAILED
  PASSED
}

enum TrainingAttemptStatus {
  IN_PROGRESS
  FAILED
  PASSED
}

enum TrainingAuditAction {
  ASSIGNED
  ACKNOWLEDGED
  OVERRIDE_GRANTED
  QUIZ_SUBMITTED
}

model User {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @default(dbgenerated())
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                String
  email               String    @unique
  password            String
  role                Role      @default(MANAGER)
  phone               String?
  active              Boolean   @default(true)
  lastLogin           DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime  @default(now())
  mustChangePassword  Boolean   @default(false)
  sessionVersion      Int       @default(1)
  employeeCode        String?   @unique

  partnerProfile               Partner?
  assignedMeasurements         Measurement[]
  assignedProductions          Production[]
  uploadedAttachments          Attachment[]                  @relation("AttachmentUploadedBy")
  clientInteractions           ClientInteraction[]           @relation("ClientInteractionAuthor")
  clientAttachments            ClientAttachment[]            @relation("ClientAttachmentUploader")
  warehouseMovements           MaterialMovement[]            @relation("WarehouseMovementEmployee")
  warehouseReservations        MaterialReservation[]         @relation("WarehouseReservationCreator")
  warehouseMutations           WarehouseMutation[]           @relation("WarehouseMutationActor")
  materialPriceChanges         MaterialPriceHistory[]        @relation("MaterialPriceChangedBy")
  companyLedgerEntries         CompanyLedgerEntry[]          @relation("CompanyLedgerAuthor")
  personalLedgerEntries        PersonalLedgerEntry[]         @relation("PersonalLedgerAuthor")
  financeAuditEvents           FinanceAuditEvent[]           @relation("FinanceAuditAuthor")
  commercialAdjustments        CommercialAdjustment[]        @relation("CommercialAdjustmentAuthor")
  partnerAssignments           PartnerAssignmentHistory[]    @relation("PartnerAssignmentAuthor")
  partnersCreated              Partner[]                     @relation("PartnerCreatedBy")
  partnerRelationsCreated      PartnerOrderRelation[]        @relation("PartnerRelationCreatedBy")
  partnerOperationsCreated     PartnerSettlementOperation[]  @relation("PartnerOperationCreatedBy")
  partnerAuditEvents           PartnerAuditEvent[]           @relation("PartnerAuditActor")
  authAuditEvents              AuthAuditEvent[]
  managedClients               Client[]                      @relation("ClientManager")
  deletedClients               Client[]                      @relation("ClientDeletedBy")
  changedLeadStages            LeadStatusHistory[]           @relation("LeadStageChangedBy")
  createdLeadActions           LeadNextAction[]              @relation("LeadActionCreatedBy")
  completedLeadActions         LeadNextAction[]              @relation("LeadActionCompletedBy")
  responsiblePurchaseBatches   PurchaseBatch[]               @relation("PurchaseBatchResponsible")
  finalizedPurchaseBatches     PurchaseBatch[]               @relation("PurchaseBatchFinalizer")
  purchaseAdditionalCosts      PurchaseAdditionalCost[]
  purchaseCostRevisions        PurchaseCostRevision[]
  payrollProfile               EmployeePayrollProfile?
  approvedSalaryRates          EmployeeSalaryRate[]          @relation("SalaryRateApprover")
  approvedPayrollAccruals      PayrollAccrual[]              @relation("PayrollAccrualApprover")
  createdPayrollAccruals       PayrollAccrual[]              @relation("PayrollAccrualCreator")
  payrollPayments              PayrollPayment[]              @relation("PayrollPaymentAuthor")
  payrollConfirmationsCreated  PayrollPaymentConfirmation[]  @relation("PayrollConfirmationCreator")
  payrollConfirmationsReviewed PayrollPaymentConfirmation[]  @relation("PayrollConfirmationReviewer")
  reviewedAdvanceRequests      PayrollAdvanceRequest[]       @relation("AdvanceReviewer")
  closedPayrollPeriods         PayrollPeriod[]               @relation("PayrollPeriodCloser")
  payrollAuditEvents           PayrollAuditEvent[]           @relation("PayrollAuditActor")
  managedOrders                Order[]                       @relation("OrderResponsibleManager")
  deletedOrders                Order[]                       @relation("OrderDeletedBy")
  openedOrderBlockers          OrderBlocker[]                @relation("OrderBlockerOpenedBy")
  responsibleOrderBlockers     OrderBlocker[]                @relation("OrderBlockerResponsible")
  resolvedOrderBlockers        OrderBlocker[]                @relation("OrderBlockerResolvedBy")
  orderGateOverrides           OrderGateOverride[]           @relation("OrderGateOverrideAuthor")
  orderLifecycleEvents         OrderLifecycleEvent[]         @relation("OrderLifecycleEventActor")
  assignedInstallations        OrderInstallation[]           @relation("OrderInstallationInstaller")
  assignedCalendarTasks        CalendarTask[]                @relation("CalendarTaskAssignee")
  createdCalendarTasks         CalendarTask[]                @relation("CalendarTaskCreator")
  completedCalendarTasks       CalendarTask[]                @relation("CalendarTaskCompleter")
  calendarTaskAuditEvents      CalendarTaskAudit[]           @relation("CalendarTaskAuditActor")
  uploadedMeasurementPhotos    MeasurementAttachment[]       @relation("MeasurementAttachmentUploader")
  measurementAuditEvents       MeasurementAudit[]            @relation("MeasurementAuditActor")
  authoredDocuments            Document[]                    @relation("DocumentAuthor")
  archivedDocuments            Document[]                    @relation("DocumentArchivedBy")
  uploadedDocumentVersions     DocumentVersion[]             @relation("DocumentVersionUploader")
  documentAuditEvents          DocumentAudit[]               @relation("DocumentAuditActor")
  memoAcknowledgements         CustomerMemoAcknowledgement[] @relation("MemoAcknowledgedBy")
  responsibleCashShifts        CashShift[]                   @relation("CashShiftResponsibleManager")
  closedCashShifts             CashShift[]                   @relation("CashShiftClosedBy")
  registeredPayments           Payment[]                     @relation("PaymentRegisteredBy")
  clientDeletionAudits         ClientDeletionAudit[]         @relation("ClientDeletionAuditActor")
  trainingAssignments          TrainingAssignment[]          @relation("TrainingAssignmentUser")
  trainingOverrides            TrainingAssignment[]          @relation("TrainingAssignmentOverrideBy")
  trainingAuditEvents          TrainingAudit[]               @relation("TrainingAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, active, role])
}

model AuthAuditEvent {
  id                    Int      @id @default(autoincrement())
  userId                Int?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String?
  accountIdentifierHash String?
  success               Boolean
  reason                String
  requestId             String?
  ipHash                String?
  userAgentClass        String?
  createdAt             DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([accountIdentifierHash, ipHash, createdAt])
  @@index([userId, createdAt])
}

model Client {
  id              Int             @id @default(autoincrement())
  companyId       Int             @default(dbgenerated())
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name            String
  phone           String
  whatsapp        String          @default("")
  city            String
  address         String          @default("")
  iin             String          @default("")
  manager         String
  amount          String
  status          String
  stage           LeadStage       @default(NEW)
  estimatedAmount Decimal         @default(0) @db.Decimal(12, 2)
  estimateNotes   String          @default("")
  source          String          @default("")
  sourceCode      LeadSource?
  comment         String          @default("")
  active          Boolean         @default(true)
  managerUserId   Int?
  managerUser     User?           @relation("ClientManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  lostReason      LeadLostReason?
  lostComment     String?
  lostAt          DateTime?
  lostByUserId    Int?
  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?           @relation("ClientDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  orders               Order[]
  interactions         ClientInteraction[]
  attachments          ClientAttachment[]
  leadActivities       LeadActivity[]
  leadStatusHistory    LeadStatusHistory[]
  leadCalculations     LeadCalculation[]
  commercialProposals  CommercialProposal[]
  leadConversion       LeadConversion?
  followUps            LeadFollowUp[]
  priceApprovals       PriceApprovalRequest[]
  nextActions          LeadNextAction[]
  calendarTasks        CalendarTask[]
  measurements         Measurement[]
  documents            Document[]
  companyLedgerEntries CompanyLedgerEntry[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  nextContactAt DateTime?

  @@index([status, nextContactAt])
  @@index([manager, status])
  @@index([source, createdAt])
  @@index([stage, createdAt])
  @@index([managerUserId, stage])
  @@index([sourceCode, createdAt])
  @@index([deletedAt, managerUserId])
  @@index([active, deletedAt, updatedAt])
  @@index([companyId, active, deletedAt])
}

model LeadActivity {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  comment    String
  authorId   Int?
  authorName String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model LeadStatusHistory {
  id         Int        @id @default(autoincrement())
  clientId   Int
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  fromStage  LeadStage?
  toStage    LeadStage?
  authorId   Int?
  changedBy  User?      @relation("LeadStageChangedBy", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  comment    String?
  createdAt  DateTime   @default(now())

  @@index([clientId, createdAt])
}

model LeadNextAction {
  id                Int                @id @default(autoincrement())
  clientId          Int
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nextActionType    LeadNextActionType
  nextActionAt      DateTime
  nextActionComment String?
  createdByUserId   Int
  createdBy         User               @relation("LeadActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedAt       DateTime?
  completedByUserId Int?
  completedBy       User?              @relation("LeadActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  resultComment     String?
  createdAt         DateTime           @default(now())

  @@index([clientId, completedAt, nextActionAt])
  @@index([createdByUserId, completedAt, nextActionAt])
}

model LeadCalculation {
  id              Int                    @id @default(autoincrement())
  clientId        Int
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  material        String
  baseClientPrice Decimal                @db.Decimal(12, 2)
  clientPrice     Decimal                @db.Decimal(12, 2)
  internalCost    Decimal                @db.Decimal(12, 2)
  snapshot        Json
  comment         String?
  authorId        Int?
  authorName      String
  createdAt       DateTime               @default(now())
  adjustments     LeadPriceAdjustment[]
  proposals       CommercialProposal[]
  priceApprovals  PriceApprovalRequest[]

  @@index([clientId, createdAt])
}

model LeadPriceAdjustment {
  id            Int             @id @default(autoincrement())
  calculationId Int
  calculation   LeadCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  originalPrice Decimal         @db.Decimal(12, 2)
  newPrice      Decimal         @db.Decimal(12, 2)
  authorId      Int?
  authorName    String
  comment       String?
  createdAt     DateTime        @default(now())

  @@index([calculationId, createdAt])
}

model CommercialProposal {
  id                 Int                    @id @default(autoincrement())
  companyId          Int                    @default(dbgenerated())
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId           Int
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  calculationId      Int
  calculation        LeadCalculation        @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  number             String                 @unique
  status             String                 @default("Черновик")
  snapshot           Json
  validUntil         DateTime
  executionTerm      String
  paymentTerms       String
  warranty           String
  managerContact     String
  sentAt             DateTime?
  acceptedAt         DateTime?
  createdById        Int?
  createdByName      String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  conversion         LeadConversion?
  priceApprovals     PriceApprovalRequest[]
  version            Int                    @default(1)
  rootNumber         String?
  total              Decimal?               @db.Decimal(12, 2)
  idempotencyKey     String?                @unique
  requestHash        String?
  providerMessageId  String?
  sendIdempotencyKey String?                @unique

  @@index([clientId, createdAt])
  @@index([status, validUntil])
  @@index([rootNumber, version])
  @@index([createdById, createdAt])
  @@index([companyId, createdAt])
}

model LeadFollowUp {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId Int?
  proposalId    Int?
  oldPrice      Decimal   @db.Decimal(12, 2)
  proposedPrice Decimal   @db.Decimal(12, 2)
  standardPrice Decimal   @db.Decimal(12, 2)
  discount      Decimal   @db.Decimal(12, 2)
  reason        String
  comment       String?
  channel       String
  managerUserId Int
  managerName   String
  nextActionAt  DateTime
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([managerUserId, nextActionAt])
  @@index([clientId, createdAt])
}

model PriceApprovalRequest {
  id                 Int                 @id @default(autoincrement())
  clientId           Int
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId      Int
  calculation        LeadCalculation     @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  proposalId         Int?
  proposal           CommercialProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  managerUserId      Int
  managerName        String
  standardSalePrice  Decimal             @db.Decimal(12, 2)
  currentSalePrice   Decimal             @db.Decimal(12, 2)
  requestedSalePrice Decimal             @db.Decimal(12, 2)
  approvedSalePrice  Decimal?            @db.Decimal(12, 2)
  snapshotHash       String
  reason             String
  comment            String?
  status             String              @default("PENDING")
  reviewedAt         DateTime?
  reviewedByUserId   Int?
  reviewedByName     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([calculationId, managerUserId, status])
  @@index([status, createdAt])
  @@index([managerUserId, createdAt])
}

model LeadConversion {
  id          Int                @id @default(autoincrement())
  clientId    Int                @unique
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposalId  Int                @unique
  proposal    CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  orderId     Int                @unique
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  managerId   Int?
  managerName String
  createdAt   DateTime           @default(now())
}

model ClientInteraction {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation("ClientInteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  comment    String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientAttachment {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById Int?
  uploadedBy   User?    @relation("ClientAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  pathname     String   @unique
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientDeletionAudit {
  id              Int      @id @default(autoincrement())
  deletedClientId Int
  clientSnapshot  Json
  impact          Json
  reason          String
  actorId         Int
  actor           User     @relation("ClientDeletionAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  deletedAt       DateTime @default(now())

  @@index([deletedClientId, deletedAt])
  @@index([actorId, deletedAt])
}

model Partner {
  id Int @id @default(autoincrement())
  companyId Int @default(dbgenerated())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name                     String
  phone                    String?
  city                     String?
  email                    String?
  secondaryPhone           String?
  iinBin                   String?
  address                  String?
  bankDetails              String?
  contactPerson            String?
  cooperationStartedAt     DateTime?
  kind                     PartnerBusinessType   @default(CONTRACTOR)
  businessStatus           PartnerBusinessStatus @default(ACTIVE)
  defaultRewardRule        PartnerRewardRule     @default(FIXED)
  defaultRewardPercent     Decimal?              @db.Decimal(7, 4)
  defaultRewardFixedAmount Decimal?              @db.Decimal(14, 2)
  comment                  String?
  managementDirectory      Boolean               @default(false)
  createdById              Int?
  createdBy                User?                 @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  active   Boolean @default(true)
  archived Boolean @default(false)
  isTest   Boolean @default(false)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orders               Order[]
  payments             Payment[]
  companyLedgerEntries CompanyLedgerEntry[]
  orderRelations       PartnerOrderRelation[]
  settlementOperations PartnerSettlementOperation[]
  auditEvents          PartnerAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, active, archived])
  @@index([companyId, businessStatus, name])
  @@index([companyId, managementDirectory, businessStatus])
}

model Order {
  id     Int    @id @default(autoincrement())
  companyId Int @default(dbgenerated())
