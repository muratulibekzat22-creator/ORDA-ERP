generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  MANAGER
  ACCOUNTANT
  MEASURER
  DESIGNER
  PARTNER
  PRODUCTION
  INSTALLER
}

enum DocumentType {
  OFFER
  CONTRACT
  ACT
  INVOICE
}

enum Permission {
  employees
  clients
  orders
  measurements
  calendar
  documents
  finance
  partners
  reports
  settings
  design
  production
  installation
  warehouse
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(MANAGER)
  phone     String?
  active    Boolean   @default(true)
  lastLogin DateTime?

  partnerProfile        Partner?
  assignedMeasurements  Measurement[]
  assignedProductions   Production[]
  uploadedAttachments   Attachment[]          @relation("AttachmentUploadedBy")
  warehouseMovements    MaterialMovement[]    @relation("WarehouseMovementEmployee")
  warehouseReservations MaterialReservation[] @relation("WarehouseReservationCreator")
  warehouseMutations    WarehouseMutation[]   @relation("WarehouseMutationActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id              Int     @id @default(autoincrement())
  name            String
  phone           String
  city            String
  manager         String
  amount          String
  status          String
  estimatedAmount Decimal @default(0) @db.Decimal(12, 2)
  estimateNotes   String  @default("")
  source          String  @default("")
  comment         String  @default("")
  active          Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id Int @id @default(autoincrement())

  name  String
  phone String?
  city  String?
  email String?

  active Boolean @default(true)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orders   Order[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     Int    @id @default(autoincrement())
  number String @unique

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  address   String
  staircase String
  material  String

  amount Decimal @db.Decimal(12, 2)

  prepayment Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @default(0) @db.Decimal(12, 2)

  partnerPrice   Decimal @default(0) @db.Decimal(12, 2)
  companyProfit  Decimal @default(0) @db.Decimal(12, 2)
  partnerPaid    Decimal @default(0) @db.Decimal(12, 2)
  partnerBalance Decimal @default(0) @db.Decimal(12, 2)

  manager String
  status  String @default("Новая заявка")

  measurements         Measurement[]
  payments             Payment[]
  productions          Production[]
  events               OrderEvent[]
  materialMovements    MaterialMovement[]
  documents            Document[]
  attachments          Attachment[]
  materialReservations MaterialReservation[]
  statusHistory        OrderStatusHistory[]
  calculations         OrderCalculation[]

  partnerPlannedReadyAt DateTime?
  partnerComment        String    @default("")
  readyForInstallation  Boolean   @default(false)
  installationCompleted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderStatusHistory {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  changedByUserId Int?
  changedByName   String
  changedByRole   Role
  comment         String?
  idempotencyKey  String?  @unique
  requestHash     String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderCalculation {
  id                  Int      @id @default(autoincrement())
  orderId             Int
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material            String
  regularSteps        Int
  platformEquivalents Int[]
  equivalentSteps     Int
  workshopRate        Decimal  @db.Decimal(12, 2)
  saleRate            Decimal  @db.Decimal(12, 2)
  baseWorkshopCost    Decimal  @db.Decimal(12, 2)
  workshopCost        Decimal  @db.Decimal(12, 2)
  baseClientPrice     Decimal  @db.Decimal(12, 2)
  clientPrice         Decimal  @db.Decimal(12, 2)
  grossDifference     Decimal  @db.Decimal(12, 2)
  workshopAdjustment  Decimal  @db.Decimal(12, 2)
  clientAdjustment    Decimal  @db.Decimal(12, 2)
  createdByUserId     Int?
  createdByName       String
  idempotencyKey      String?  @unique
  requestHash         String?
  createdAt           DateTime @default(now())

  @@index([orderId, createdAt])
}

model Document {
  id             Int          @id @default(autoincrement())
  orderId        Int
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           DocumentType
  number         String
  documentDate   DateTime
  idempotencyKey String?      @unique
  requestHash    String?
  attachments    Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, type])
  @@unique([type, number])
}

model Attachment {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentId     Int?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById   Int?
  uploadedBy     User?     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName       String
  pathname       String    @unique
  contentType    String
  size           Int
  idempotencyKey String?   @unique
  requestHash    String?
  createdAt      DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([documentId, createdAt])
}

model Material {
  id             Int     @id @default(autoincrement())
  name           String
  category       String
  unit           String
  minimumStock   Float   @default(0)
  stock          Float   @default(0)
  purchasePrice  Decimal @default(0) @db.Decimal(12, 2)
  supplier       String?
  active         Boolean @default(true)
  lookupKey      String  @unique
  reserved       Float   @default(0)
  idempotencyKey String? @unique
  requestHash    String?

  movements    MaterialMovement[]
  reservations MaterialReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id            Int    @id @default(1)
  name          String @default("ALTYN SAPA COMPANY")
  bin           String @default("")
  legalAddress  String @default("")
  actualAddress String @default("")
  phone         String @default("")
  whatsapp      String @default("")
  email         String @default("")
  bankDetails   String @default("")
  directorName  String @default("")
  logoUrl       String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id                   Int    @id @default(1)
  currency             String @default("KZT")
  timezone             String @default("Asia/Almaty")
  dateFormat           String @default("dd.MM.yyyy")
  minimumPrepayment    Int    @default(0)
  measurementLeadDays  Int    @default(3)
  productionLeadDays   Int    @default(40)
  installationLeadDays Int    @default(7)
  nextDocumentNumber   Int    @default(1)
  offerPrefix          String @default("КП")
  contractPrefix       String @default("ДОГ")
  actPrefix            String @default("АКТ")
  invoicePrefix        String @default("СЧ")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id         Int        @id @default(autoincrement())
  role       Role
  permission Permission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
}

model MaterialMovement {
  id Int @id @default(autoincrement())

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type           String
  quantity       Float
  price          Decimal  @default(0) @db.Decimal(12, 2)
  supplier       String?
  comment        String?
  idempotencyKey String?  @unique
  requestHash    String?
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  stockAfter     Float?
  reservedAfter  Float?
  stockDelta     Float    @default(0)
  reserveDelta   Float    @default(0)
  employeeId     Int?
  employee       User?    @relation("WarehouseMovementEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  operationAt    DateTime @default(now())

  createdAt DateTime @default(now())
}

model MaterialReservation {
  id          Int       @id @default(autoincrement())
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quantity    Float     @default(0)
  consumed    Float     @default(0)
  status      String    @default("ACTIVE")
  createdById Int?
  createdBy   User?     @relation("WarehouseReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderId, materialId])
  @@index([materialId, status])
  @@index([orderId, status])
}

model WarehouseMutation {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  requestHash String
  action      String
  result      Json
  actorId     Int?
  actor       User?    @relation("WarehouseMutationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Measurement {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  measurer       String
  measurerUserId Int?
  measurerUser   User?    @relation(fields: [measurerUserId], references: [id], onDelete: SetNull)
  visitDate      DateTime

  floorHeight    Float?
  staircaseWidth Float?
  stepsCount     Int?

  comment        String?
  idempotencyKey String? @unique
  requestHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  amount Float

  type   String
  method String

  comment        String?
  operationDate  DateTime @default(now())
  author         String?
  idempotencyKey String?  @unique
  requestHash    String?

  createdAt DateTime @default(now())
}

model Production {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage   String
  percent Int    @default(0)

  master       String
  masterUserId Int?
  masterUser   User?  @relation(fields: [masterUserId], references: [id], onDelete: SetNull)

  startDate  DateTime?
  finishDate DateTime?

  comment        String?
  priority       Int                      @default(0)
  completedAt    DateTime?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualEndAt    DateTime?
  stageHistory   ProductionStageHistory[]
  idempotencyKey String?                  @unique
  requestHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionStageHistory {
  id              Int        @id @default(autoincrement())
  productionId    Int
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  fromStage       String?
  toStage         String
  changedByUserId Int?
  comment         String?
  idempotencyKey  String?    @unique
  requestHash     String?
  createdAt       DateTime   @default(now())

  @@index([productionId, createdAt])
}

model Settings {
  id Int @id @default(1)

  pinePrice Int @default(65000)
  elmPrice  Int @default(85000)
  oakPrice  Int @default(110000)

  woodRailing  Int @default(650000)
  glassRailing Int @default(900000)
  brassRailing Int @default(1800000)

  ledPrice          Int @default(250000)
  paintingPrice     Int @default(300000)
  installationPrice Int @default(350000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderEvent {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title       String
  description String?

  user           String?
  idempotencyKey String? @unique
  requestHash    String?

  createdAt DateTime @default(now())
}
