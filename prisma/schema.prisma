generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  MANAGER
  ACCOUNTANT
  MEASURER
  DESIGNER
  PARTNER
  PRODUCTION
  INSTALLER
}

enum DocumentType {
  OFFER
  CONTRACT
  ACT
  INVOICE
}

enum Permission {
  employees
  clients
  orders
  measurements
  calendar
  documents
  finance
  partners
  reports
  settings
  design
  production
  installation
  warehouse
  payroll
}

enum LeadStage {
  NEW
  QUALIFIED
  CALCULATION_READY
  PROPOSAL_SENT
  FOLLOW_UP
  MEASUREMENT_SCHEDULED
  MEASUREMENT_COMPLETED
  NEGOTIATION
  WON
  LOST
}

enum LeadNextActionType {
  CALL
  WHATSAPP
  FOLLOW_UP
  MEASUREMENT
  MEETING
  CALCULATION
  PROPOSAL
  OTHER
}

enum PurchaseBatchStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  RECEIVED_PROVISIONAL
  COST_FINALIZED
  CLOSED
  CANCELLED
}

enum PurchaseAllocationMethod {
  BY_PURCHASE_VALUE
  BY_QUANTITY
  BY_WEIGHT
  MANUAL
}

enum PurchaseCostType {
  SUPPLIER_COMMISSION
  BANK_COMMISSION
  CARGO
  DELIVERY
  CUSTOMS
  INSURANCE
  PACKAGING
  CERTIFICATION
  OTHER
  SUPPLIER_CREDIT
}

enum InventoryCostStatus {
  LEGACY_UNVERIFIED
  PROVISIONAL
  FINAL
}

enum PayrollPeriodStatus {
  OPEN
  REVIEW
  CLOSED
}

enum PayrollAccrualType {
  BASE_SALARY
  GUARANTEED_ORDER_BONUS
  ORDER_BONUS
  EXTRA_BONUS
  PREMIUM
  DEDUCTION
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  BONUS_REVERSAL
}

enum PayrollDirection {
  INCREASE
  DECREASE
}

enum PayrollPaymentType {
  ADVANCE
  IMMEDIATE_BONUS
  SALARY_PAYMENT
  FINAL_SETTLEMENT
  OTHER_PAYROLL_PAYMENT
  EMPLOYEE_REFUND
}

enum AdvanceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum BonusPaymentMode {
  ACCUMULATE
  IMMEDIATE
}

enum OrderLifecycle {
  CREATED
  PREPARATION
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  READY_FOR_INSTALLATION
  INSTALLATION
  ACCEPTANCE
  COMPLETED
  CANCELLED
}

enum OrderBlockerSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrderBlockerStatus {
  OPEN
  RESOLVED
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  CALL
  WEBSITE
  REFERRAL
  OFFICE
  REPEAT
  OTHER
}

enum LeadLostReason {
  EXPENSIVE
  NO_RESPONSE
  COMPETITOR
  POSTPONED
  NO_BUDGET
  NOT_RELEVANT
  LOCATION
  TIMING
  OTHER
}

enum CalendarTaskType {
  CALL
  MEETING
  MEASUREMENT
  INSTALLATION
  DELIVERY
  TASK
  REMINDER
  OTHER
}

enum CalendarTaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CalendarTaskPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(MANAGER)
  phone               String?
  active              Boolean   @default(true)
  lastLogin           DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime  @default(now())
  mustChangePassword  Boolean   @default(false)
  sessionVersion      Int       @default(1)

  partnerProfile             Partner?
  assignedMeasurements       Measurement[]
  assignedProductions        Production[]
  uploadedAttachments        Attachment[]               @relation("AttachmentUploadedBy")
  clientInteractions         ClientInteraction[]        @relation("ClientInteractionAuthor")
  clientAttachments          ClientAttachment[]         @relation("ClientAttachmentUploader")
  warehouseMovements         MaterialMovement[]         @relation("WarehouseMovementEmployee")
  warehouseReservations      MaterialReservation[]      @relation("WarehouseReservationCreator")
  warehouseMutations         WarehouseMutation[]        @relation("WarehouseMutationActor")
  companyLedgerEntries       CompanyLedgerEntry[]       @relation("CompanyLedgerAuthor")
  personalLedgerEntries      PersonalLedgerEntry[]      @relation("PersonalLedgerAuthor")
  financeAuditEvents         FinanceAuditEvent[]        @relation("FinanceAuditAuthor")
  commercialAdjustments      CommercialAdjustment[]     @relation("CommercialAdjustmentAuthor")
  partnerAssignments         PartnerAssignmentHistory[] @relation("PartnerAssignmentAuthor")
  authAuditEvents            AuthAuditEvent[]
  managedClients             Client[]                   @relation("ClientManager")
  changedLeadStages          LeadStatusHistory[]        @relation("LeadStageChangedBy")
  createdLeadActions         LeadNextAction[]           @relation("LeadActionCreatedBy")
  completedLeadActions       LeadNextAction[]           @relation("LeadActionCompletedBy")
  responsiblePurchaseBatches PurchaseBatch[]            @relation("PurchaseBatchResponsible")
  finalizedPurchaseBatches   PurchaseBatch[]            @relation("PurchaseBatchFinalizer")
  purchaseAdditionalCosts    PurchaseAdditionalCost[]
  purchaseCostRevisions      PurchaseCostRevision[]
  payrollProfile             EmployeePayrollProfile?
  approvedSalaryRates        EmployeeSalaryRate[]       @relation("SalaryRateApprover")
  approvedPayrollAccruals    PayrollAccrual[]           @relation("PayrollAccrualApprover")
  createdPayrollAccruals     PayrollAccrual[]           @relation("PayrollAccrualCreator")
  payrollPayments            PayrollPayment[]           @relation("PayrollPaymentAuthor")
  reviewedAdvanceRequests    PayrollAdvanceRequest[]    @relation("AdvanceReviewer")
  closedPayrollPeriods       PayrollPeriod[]            @relation("PayrollPeriodCloser")
  managedOrders              Order[]                    @relation("OrderResponsibleManager")
  openedOrderBlockers        OrderBlocker[]             @relation("OrderBlockerOpenedBy")
  responsibleOrderBlockers   OrderBlocker[]             @relation("OrderBlockerResponsible")
  resolvedOrderBlockers      OrderBlocker[]             @relation("OrderBlockerResolvedBy")
  orderGateOverrides         OrderGateOverride[]        @relation("OrderGateOverrideAuthor")
  orderLifecycleEvents       OrderLifecycleEvent[]      @relation("OrderLifecycleEventActor")
  assignedInstallations      OrderInstallation[]        @relation("OrderInstallationInstaller")
  assignedCalendarTasks      CalendarTask[]             @relation("CalendarTaskAssignee")
  createdCalendarTasks       CalendarTask[]             @relation("CalendarTaskCreator")
  completedCalendarTasks     CalendarTask[]             @relation("CalendarTaskCompleter")
  calendarTaskAuditEvents    CalendarTaskAudit[]        @relation("CalendarTaskAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthAuditEvent {
  id                    Int      @id @default(autoincrement())
  userId                Int?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String?
  accountIdentifierHash String?
  success               Boolean
  reason                String
  requestId             String?
  ipHash                String?
  userAgentClass        String?
  createdAt             DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([accountIdentifierHash, ipHash, createdAt])
  @@index([userId, createdAt])
}

model Client {
  id              Int             @id @default(autoincrement())
  name            String
  phone           String
  whatsapp        String          @default("")
  city            String
  address         String          @default("")
  manager         String
  amount          String
  status          String
  stage           LeadStage       @default(NEW)
  estimatedAmount Decimal         @default(0) @db.Decimal(12, 2)
  estimateNotes   String          @default("")
  source          String          @default("")
  sourceCode      LeadSource?
  comment         String          @default("")
  active          Boolean         @default(true)
  managerUserId   Int?
  managerUser     User?           @relation("ClientManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  lostReason      LeadLostReason?
  lostComment     String?
  lostAt          DateTime?
  lostByUserId    Int?

  orders              Order[]
  interactions        ClientInteraction[]
  attachments         ClientAttachment[]
  leadActivities      LeadActivity[]
  leadStatusHistory   LeadStatusHistory[]
  leadCalculations    LeadCalculation[]
  commercialProposals CommercialProposal[]
  leadConversion      LeadConversion?
  followUps           LeadFollowUp[]
  priceApprovals      PriceApprovalRequest[]
  nextActions         LeadNextAction[]
  calendarTasks       CalendarTask[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  nextContactAt DateTime?

  @@index([status, nextContactAt])
  @@index([manager, status])
  @@index([source, createdAt])
  @@index([stage, createdAt])
  @@index([managerUserId, stage])
  @@index([sourceCode, createdAt])
}

model LeadActivity {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  comment    String
  authorId   Int?
  authorName String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model LeadStatusHistory {
  id         Int        @id @default(autoincrement())
  clientId   Int
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  fromStage  LeadStage?
  toStage    LeadStage?
  authorId   Int?
  changedBy  User?      @relation("LeadStageChangedBy", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  comment    String?
  createdAt  DateTime   @default(now())

  @@index([clientId, createdAt])
}

model LeadNextAction {
  id                Int                @id @default(autoincrement())
  clientId          Int
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nextActionType    LeadNextActionType
  nextActionAt      DateTime
  nextActionComment String?
  createdByUserId   Int
  createdBy         User               @relation("LeadActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedAt       DateTime?
  completedByUserId Int?
  completedBy       User?              @relation("LeadActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  resultComment     String?
  createdAt         DateTime           @default(now())

  @@index([clientId, completedAt, nextActionAt])
  @@index([createdByUserId, completedAt, nextActionAt])
}

model LeadCalculation {
  id              Int                    @id @default(autoincrement())
  clientId        Int
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  material        String
  baseClientPrice Decimal                @db.Decimal(12, 2)
  clientPrice     Decimal                @db.Decimal(12, 2)
  internalCost    Decimal                @db.Decimal(12, 2)
  snapshot        Json
  comment         String?
  authorId        Int?
  authorName      String
  createdAt       DateTime               @default(now())
  adjustments     LeadPriceAdjustment[]
  proposals       CommercialProposal[]
  priceApprovals  PriceApprovalRequest[]

  @@index([clientId, createdAt])
}

model LeadPriceAdjustment {
  id            Int             @id @default(autoincrement())
  calculationId Int
  calculation   LeadCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  originalPrice Decimal         @db.Decimal(12, 2)
  newPrice      Decimal         @db.Decimal(12, 2)
  authorId      Int?
  authorName    String
  comment       String?
  createdAt     DateTime        @default(now())

  @@index([calculationId, createdAt])
}

model CommercialProposal {
  id                 Int                    @id @default(autoincrement())
  clientId           Int
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  calculationId      Int
  calculation        LeadCalculation        @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  number             String                 @unique
  status             String                 @default("Черновик")
  snapshot           Json
  validUntil         DateTime
  executionTerm      String
  paymentTerms       String
  warranty           String
  managerContact     String
  sentAt             DateTime?
  acceptedAt         DateTime?
  createdById        Int?
  createdByName      String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  conversion         LeadConversion?
  priceApprovals     PriceApprovalRequest[]
  version            Int                    @default(1)
  rootNumber         String?
  total              Decimal?               @db.Decimal(12, 2)
  idempotencyKey     String?                @unique
  requestHash        String?
  providerMessageId  String?
  sendIdempotencyKey String?                @unique

  @@index([clientId, createdAt])
  @@index([status, validUntil])
  @@index([rootNumber, version])
  @@index([createdById, createdAt])
}

model LeadFollowUp {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId Int?
  proposalId    Int?
  oldPrice      Decimal   @db.Decimal(12, 2)
  proposedPrice Decimal   @db.Decimal(12, 2)
  standardPrice Decimal   @db.Decimal(12, 2)
  discount      Decimal   @db.Decimal(12, 2)
  reason        String
  comment       String?
  channel       String
  managerUserId Int
  managerName   String
  nextActionAt  DateTime
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([managerUserId, nextActionAt])
  @@index([clientId, createdAt])
}

model PriceApprovalRequest {
  id                 Int                 @id @default(autoincrement())
  clientId           Int
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationId      Int
  calculation        LeadCalculation     @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  proposalId         Int?
  proposal           CommercialProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  managerUserId      Int
  managerName        String
  standardSalePrice  Decimal             @db.Decimal(12, 2)
  currentSalePrice   Decimal             @db.Decimal(12, 2)
  requestedSalePrice Decimal             @db.Decimal(12, 2)
  approvedSalePrice  Decimal?            @db.Decimal(12, 2)
  snapshotHash       String
  reason             String
  comment            String?
  status             String              @default("PENDING")
  reviewedAt         DateTime?
  reviewedByUserId   Int?
  reviewedByName     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([calculationId, managerUserId, status])
  @@index([status, createdAt])
  @@index([managerUserId, createdAt])
}

model LeadConversion {
  id          Int                @id @default(autoincrement())
  clientId    Int                @unique
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposalId  Int                @unique
  proposal    CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  orderId     Int                @unique
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  managerId   Int?
  managerName String
  createdAt   DateTime           @default(now())
}

model ClientInteraction {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation("ClientInteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  comment    String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientAttachment {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById Int?
  uploadedBy   User?    @relation("ClientAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  pathname     String   @unique
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
}

model Partner {
  id Int @id @default(autoincrement())

  name  String
  phone String?
  city  String?
  email String?

  active Boolean @default(true)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orders   Order[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     Int    @id @default(autoincrement())
  number String @unique

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  address   String
  staircase String
  material  String

  amount Decimal @db.Decimal(12, 2)

  prepayment Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @default(0) @db.Decimal(12, 2)

  partnerPrice   Decimal @default(0) @db.Decimal(12, 2)
  companyProfit  Decimal @default(0) @db.Decimal(12, 2)
  partnerPaid    Decimal @default(0) @db.Decimal(12, 2)
  partnerBalance Decimal @default(0) @db.Decimal(12, 2)

  manager                       String
  managerUserId                 Int?
  managerUser                   User?          @relation("OrderResponsibleManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  lifecycle                     OrderLifecycle @default(CREATED)
  version                       Int            @default(1)
  promisedAt                    DateTime?
  requiredPrepayment            Decimal        @default(0) @db.Decimal(14, 2)
  contractConfirmedAt           DateTime?
  controlMeasurementCompletedAt DateTime?
  drawingApprovedAt             DateTime?
  specificationDefinedAt        DateTime?
  workshopConfirmedAt           DateTime?
  productionDeadline            DateTime?
  materialsReadyAt              DateTime?
  qaRequired                    Boolean        @default(false)
  qaApprovedAt                  DateTime?
  completenessConfirmedAt       DateTime?
  operationalAcceptedAt         DateTime?
  completedAt                   DateTime?
  status                        String         @default("Новая заявка")

  measurements             Measurement[]
  payments                 Payment[]
  productions              Production[]
  events                   OrderEvent[]
  materialMovements        MaterialMovement[]
  documents                Document[]
  attachments              Attachment[]
  materialReservations     MaterialReservation[]
  statusHistory            OrderStatusHistory[]
  calculations             OrderCalculation[]
  companyLedgerEntries     CompanyLedgerEntry[]
  leadConversion           LeadConversion?
  commercialAdjustments    CommercialAdjustment[]
  partnerAssignmentHistory PartnerAssignmentHistory[]
  financeAuditEvents       FinanceAuditEvent[]
  inventoryCogsEntries     InventoryCogsEntry[]
  payrollAccruals          PayrollAccrual[]
  blockers                 OrderBlocker[]
  gateOverrides            OrderGateOverride[]
  lifecycleEvents          OrderLifecycleEvent[]
  installation             OrderInstallation?
  calendarTasks            CalendarTask[]

  partnerPlannedReadyAt DateTime?
  partnerComment        String    @default("")
  readyForInstallation  Boolean   @default(false)
  installationCompleted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycle, promisedAt])
  @@index([managerUserId, lifecycle])
}

model CalendarTask {
  id            Int                  @id @default(autoincrement())
  title         String
  description   String?
  type          CalendarTaskType
  dueAt         DateTime
  status        CalendarTaskStatus   @default(PLANNED)
  priority      CalendarTaskPriority @default(NORMAL)
  assigneeId    Int
  assignee      User                 @relation("CalendarTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creatorId     Int
  creator       User                 @relation("CalendarTaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  clientId      Int?
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  orderId       Int?
  order         Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  completedAt   DateTime?
  completedById Int?
  completedBy   User?                @relation("CalendarTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  auditEvents   CalendarTaskAudit[]

  @@index([assigneeId, dueAt])
  @@index([status, dueAt])
  @@index([clientId, dueAt])
  @@index([orderId, dueAt])
}

model CalendarTaskAudit {
  id        Int          @id @default(autoincrement())
  taskId    Int
  task      CalendarTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  action    String
  before    Json?
  after     Json?
  actorId   Int
  actor     User         @relation("CalendarTaskAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

model OrderBlocker {
  id                Int                  @id @default(autoincrement())
  orderId           Int
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type              String
  severity          OrderBlockerSeverity
  title             String
  comment           String?
  responsibleUserId Int?
  responsibleUser   User?                @relation("OrderBlockerResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  openedAt          DateTime             @default(now())
  openedById        Int
  openedBy          User                 @relation("OrderBlockerOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  dueAt             DateTime?
  resolvedAt        DateTime?
  resolvedById      Int?
  resolvedBy        User?                @relation("OrderBlockerResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolution        String?
  status            OrderBlockerStatus   @default(OPEN)
  idempotencyKey    String               @unique
  requestHash       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderId, status, severity])
}

model OrderGateOverride {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  gate           String
  reason         String
  snapshot       Json
  authorId       Int
  author         User     @relation("OrderGateOverrideAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  idempotencyKey String   @unique
  requestHash    String
  createdAt      DateTime @default(now())

  @@index([orderId, gate, createdAt])
}

model OrderLifecycleEvent {
  id             Int             @id @default(autoincrement())
  orderId        Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type           String
  fromLifecycle  OrderLifecycle?
  toLifecycle    OrderLifecycle?
  message        String?
  actorId        Int?
  actor          User?           @relation("OrderLifecycleEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String
  role           Role
  metadata       Json?
  idempotencyKey String?         @unique
  requestHash    String?
  createdAt      DateTime        @default(now())

  @@index([orderId, createdAt])
}

model OrderInstallation {
  id               Int       @id @default(autoincrement())
  orderId          Int       @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  scheduledAt      DateTime
  installerUserId  Int
  installerUser    User      @relation("OrderInstallationInstaller", fields: [installerUserId], references: [id], onDelete: Restrict)
  packageConfirmed Boolean   @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  comment          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OrderStatusHistory {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  changedByUserId Int?
  changedByName   String
  changedByRole   Role
  comment         String?
  idempotencyKey  String?  @unique
  requestHash     String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderCalculation {
  id                   Int                    @id @default(autoincrement())
  orderId              Int
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material             String
  regularSteps         Int
  platformEquivalents  Int[]
  equivalentSteps      Int
  workshopRate         Decimal                @db.Decimal(12, 2)
  saleRate             Decimal                @db.Decimal(12, 2)
  baseWorkshopCost     Decimal                @db.Decimal(12, 2)
  workshopCost         Decimal                @db.Decimal(12, 2)
  baseClientPrice      Decimal                @db.Decimal(12, 2)
  clientPrice          Decimal                @db.Decimal(12, 2)
  grossDifference      Decimal                @db.Decimal(12, 2)
  workshopAdjustment   Decimal                @db.Decimal(12, 2)
  clientAdjustment     Decimal                @db.Decimal(12, 2)
  installationRequired Boolean                @default(true)
  deliveryRequired     Boolean                @default(true)
  otherCity            Boolean                @default(false)
  pickup               Boolean                @default(false)
  materialCost         Decimal                @default(0) @db.Decimal(12, 2)
  installationCost     Decimal                @default(0) @db.Decimal(12, 2)
  deliveryCost         Decimal                @default(0) @db.Decimal(12, 2)
  otherDirectCosts     Decimal                @default(0) @db.Decimal(12, 2)
  totalCost            Decimal                @default(0) @db.Decimal(12, 2)
  grossProfit          Decimal                @default(0) @db.Decimal(12, 2)
  lines                OrderCalculationLine[]
  createdByUserId      Int?
